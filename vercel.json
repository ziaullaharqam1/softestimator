{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/live-prices.js": {
      "includeFiles": "server/**",
      "maxDuration": 60
    },
    "api/estimates/file.js": {
      "includeFiles": "estimates/**"
    }
  },
  "rewrites": [
    { "source": "/estimates", "destination": "/api/estimates/index" },
    { "source": "/estimates/login", "destination": "/api/estimates/login" },
    { "source": "/estimates/logout", "destination": "/api/estimates/logout" },
    { "source": "/estimates/files/:name", "destination": "/api/estimates/file?name=:name" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
